[Unit]
Description=Weekly Report Generator (Zhi Fa Chu Weekly Report)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/weekly-report
Environment="PATH=/opt/weekly-report/venv/bin"
Environment="REPORT_DATA_DIR=/opt/weekly-report/data"
ExecStart=/opt/weekly-report/venv/bin/streamlit run streamlit_app.py --server.address 0.0.0.0 --server.port 8501 --browser.gatherUsageStats false
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
